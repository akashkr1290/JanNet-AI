# JanNet AI - AI Service environment configuration (Phase 7)
# Copy to .env for local runs. Never commit a real .env (see root .gitignore).

# --- Service identity / internal auth ---------------------------------
# Shared secret the Spring Boot backend must present as the
# X-Internal-Api-Key header on every call (SRS 20.3: "Internal
# service-to-service auth (API key)"). No default - startup fails if unset
# in any environment where AI_SERVICE_ENV != local.
AI_SERVICE_API_KEY=change-me-in-every-real-environment
AI_SERVICE_ENV=local

# --- Server ---------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001

# --- Confidence / threshold configuration (SRS 15.4, 21.1) ----------------
# Below this overall confidence, the complaint is routed to the
# Verification Team queue instead of auto-approved.
AUTO_APPROVE_CONFIDENCE_THRESHOLD=50.0
# YOLOv11 minimum per-class detection threshold; below this, no class is
# treated as a valid detection at all (SRS 21.1 fallback logic).
MIN_DETECTION_THRESHOLD=50.0
# Confidence ceiling applied when Gemini is unavailable/times out/rate
# limited and the pipeline falls back to YOLOv11-only (SRS 15.4 Exceptions).
GEMINI_FALLBACK_CONFIDENCE_CAP=70.0

# --- Image quality gate (SRS 21.3) -----------------------------------------
# Audit GAP-032: SRS 17.2 minimum 480p (short side).
MIN_IMAGE_WIDTH_PX=480
MIN_IMAGE_HEIGHT_PX=480
# Audit GAP-009: longer side is reduced to this before denoising (speed).
PREPROCESS_MAX_SIDE_PX=1600
# Variance-of-Laplacian threshold below which an image is flagged Blurry.
BLUR_VARIANCE_THRESHOLD=80.0
MAX_IMAGE_BYTES=10485760

# --- YOLOv11 (SRS 21.1) -----------------------------------------------------
# No trained model ships with this repo (ARCHITECTURE.md Section 5). Path is
# configurable so a real model can be dropped in without a code change; see
# models/README.md for the expected placement/versioning convention.
YOLO_MODEL_PATH=models/yolov11_civic.pt
YOLO_MODEL_VERSION=YOLOv11-civic-UNTRAINED

# --- Gemini API (SRS 21.2) --------------------------------------------------
# Leave unset to run in fallback-only mode (no external calls attempted).
GEMINI_API_KEY=
# Audit GAP-007: gemini-1.5-flash was shut down; use a current model from
# https://ai.google.dev/gemini-api/docs/models (SDK: google-genai).
GEMINI_MODEL_NAME=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=8

# --- OCR (SRS 21.4) ----------------------------------------------------------
OCR_ENABLED=true
# Only needed if the tesseract binary isn't on PATH.
TESSERACT_CMD_PATH=

# --- Outbound image fetch (for image_url requests) --------------------------
IMAGE_FETCH_TIMEOUT_SECONDS=10

# --- Priority Prediction / Severity Scoring (SRS 15.8, 21.6, Phase 10) -----
# "corroboration count above a configured threshold raises severity by one
# level" (15.8 Business Rules).
PRIORITY_CORROBORATION_SEVERITY_THRESHOLD=3
# Comma-separated IssueCategory values that always force CRITICAL severity
# regardless of other scoring inputs (15.8 Business Rules). Only
# OPEN_MANHOLE exists as a real safety-hazard category in this project's
# locked category set - see app/services/priority_service.py's module
# docstring for why "exposed live wire" isn't a separate entry here.
PRIORITY_SAFETY_HAZARD_CATEGORIES=OPEN_MANHOLE

# --- Budget Prediction (SRS 15.9, 21.8, Phase 10) ---------------------------
# Global sanity floor/ceiling applied to every cost estimate (see
# app/services/budget_service.py module docstring - the SRS's literal
# "per category" guardrail wording isn't implemented yet, no Admin
# configuration mechanism exists for that granularity).
BUDGET_GUARDRAIL_MIN_INR=500.0
BUDGET_GUARDRAIL_MAX_INR=500000.0
