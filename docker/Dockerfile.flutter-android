# syntax=docker/dockerfile:1
# JANNet AI - Flutter Android BUILD environment (on-demand service `flutter-android`).
#
# Produces APK/AAB from the bind-mounted flutter/ source; it does not run an
# emulator and is never started by `docker compose up`. Artifacts land in
# flutter/build/app/outputs/ on the host. See docs/FLUTTER_DOCKER_SETUP.md.
#
# Versions come from the project and from Flutter 3.47.1's own tooling
# (packages/flutter_tools/lib/src/android/gradle_utils.dart and
# FlutterExtension.kt at tag 3.47.1):
#   Flutter 3.47.1 (flutter/.metadata revision 6655482e) - bundles Dart 3.13.1
#   JDK 17        - Flutter's minimum and default Java for AGP >= 8.0
#   compileSdk / targetSdk 36, minSdk 24, NDK 28.2.13676358
#   Gradle 9.3.1 / AGP 9.1.0 / Kotlin 2.4.0 - pinned in flutter/android/*.gradle.kts
#     and gradle-wrapper.properties (downloaded by the Gradle wrapper at first build).
# ANDROID_BUILD_TOOLS is pre-installed for speed; if AGP asks for a different
# build-tools revision it installs it itself (licenses are accepted and the SDK
# is owned by the build user).

FROM eclipse-temurin:17-jdk-jammy

ARG FLUTTER_VERSION=3.47.1
ARG ANDROID_PLATFORM=android-36
ARG ANDROID_BUILD_TOOLS=36.0.0
ARG ANDROID_NDK=28.2.13676358
# Bootstrap package for sdkmanager only (it installs the SDK components above).
ARG ANDROID_CMDLINE_TOOLS_BUILD=11076708
# Match the host user so files written into the bind-mounted project are not root-owned.
ARG USER_UID=1000
ARG USER_GID=1000

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    FLUTTER_HOME=/opt/flutter \
    PUB_CACHE=/home/flutter/.pub-cache \
    GRADLE_USER_HOME=/home/flutter/.gradle \
    FLUTTER_SUPPRESS_ANALYTICS=true \
    CI=true
ENV PATH="${FLUTTER_HOME}/bin:${FLUTTER_HOME}/bin/cache/dart-sdk/bin:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git unzip xz-utils zip libglu1-mesa \
    && rm -rf /var/lib/apt/lists/*

RUN (getent group "${USER_GID}" || groupadd --gid "${USER_GID}" flutter) \
    && useradd --uid "${USER_UID}" --gid "${USER_GID}" --create-home --shell /bin/bash flutter \
    && mkdir -p "${ANDROID_HOME}" "${FLUTTER_HOME}" /workspace \
    && chown -R "${USER_UID}:${USER_GID}" "${ANDROID_HOME}" "${FLUTTER_HOME}" /workspace

USER flutter

# `yes | ...` accepts SDK licenses. pipefail is deliberately NOT set: `yes` is
# killed by SIGPIPE when the command exits, so with pipefail the step would
# fail (exit 141) even on success. The command's own exit status is used.
# hadolint ignore=DL4006
RUN curl -fsSL -o /tmp/cmdline-tools.zip \
        "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_BUILD}_latest.zip" \
    && mkdir -p "${ANDROID_HOME}/cmdline-tools" \
    && unzip -q /tmp/cmdline-tools.zip -d "${ANDROID_HOME}/cmdline-tools" \
    && mv "${ANDROID_HOME}/cmdline-tools/cmdline-tools" "${ANDROID_HOME}/cmdline-tools/latest" \
    && rm /tmp/cmdline-tools.zip \
    && yes | sdkmanager --licenses > /dev/null \
    && sdkmanager --install "platform-tools" "platforms;${ANDROID_PLATFORM}" \
        "build-tools;${ANDROID_BUILD_TOOLS}" "ndk;${ANDROID_NDK}"

# `yes | ...` accepts SDK licenses. pipefail is deliberately NOT set: `yes` is
# killed by SIGPIPE when the command exits, so with pipefail the step would
# fail (exit 141) even on success. The command's own exit status is used.
# hadolint ignore=DL4006
RUN git clone --depth 1 --branch "${FLUTTER_VERSION}" https://github.com/flutter/flutter.git "${FLUTTER_HOME}" \
    && flutter --disable-analytics \
    && flutter config --android-sdk "${ANDROID_HOME}" --no-cli-animations \
    && flutter precache --android \
    && yes | flutter doctor --android-licenses > /dev/null \
    && flutter --version

# Pre-create the cache directories as the build user: the Compose named volumes
# mounted here inherit this ownership (an absent path would be created root-owned).
RUN mkdir -p "${PUB_CACHE}" "${GRADLE_USER_HOME}"

WORKDIR /workspace/flutter
CMD ["flutter", "doctor", "-v"]
