# syntax=docker/dockerfile:1
# JANNet AI - Flutter Web frontend (always-running service `flutter-frontend`).
#
# Stage 1 builds the Flutter web release bundle with the project's own SDK
# version; stage 2 serves it from nginx. The runtime image contains no Flutter
# SDK. See docs/FLUTTER_DOCKER_SETUP.md.
#
# Versions are not guesses:
#   FLUTTER_VERSION 3.47.1 = flutter/.metadata revision 6655482e (tag 3.47.1),
#   which satisfies pubspec.lock (flutter >= 3.44.0, dart >= 3.12.0; the SDK
#   bundles Dart 3.13.1).
#
# Build context is the repository root (same as the backend/ai-service images).
# The root .dockerignore excludes flutter/ for those images, so this image uses
# its own Dockerfile-specific ignore file: docker/Dockerfile.flutter-web.dockerignore
# (BuildKit, the default builder for `docker compose build`).

ARG FLUTTER_VERSION=3.47.1

# `sdk` = the pinned Flutter SDK alone. Also used on its own (docker build
# --target sdk) to regenerate flutter/pubspec.lock after a pubspec change:
#   docker run --rm -v "$PWD/flutter:/src" -w /src <sdk image> flutter pub get
FROM debian:bookworm-slim AS sdk
ARG FLUTTER_VERSION
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git unzip xz-utils zip \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "${FLUTTER_VERSION}" https://github.com/flutter/flutter.git /opt/flutter \
    && git config --global --add safe.directory /opt/flutter
ENV PATH="/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}" \
    FLUTTER_SUPPRESS_ANALYTICS=true \
    CI=true
RUN flutter --disable-analytics \
    && flutter config --enable-web --no-cli-animations \
    && flutter precache --web \
    && flutter --version

FROM sdk AS build
WORKDIR /src
# Dependencies first so they are cached independently of source edits.
COPY flutter/pubspec.yaml flutter/pubspec.lock ./
RUN flutter pub get --enforce-lockfile
COPY flutter/ ./

# The web template's PNG icons are copied from the SDK at build time instead of
# being committed (they ship inside the Flutter SDK's own templates).
RUN mkdir -p web/icons \
    && for f in favicon.png icons/Icon-192.png icons/Icon-512.png; do \
         [ -f "web/$f" ] || cp "/opt/flutter/packages/flutter_tools/templates/app/web/$f.copy.tmpl" "web/$f"; \
       done

# API_BASE_URL is compiled into the app (lib/core/api/api_config.dart reads it via
# String.fromEnvironment). Flutter Web runs in the user's BROWSER, so this must be
# an address the browser can reach (e.g. http://localhost:8080/api/v1), never a
# Compose service name such as http://backend:8080.
ARG API_BASE_URL=http://localhost:8080/api/v1
RUN flutter build web --release --dart-define=API_BASE_URL="${API_BASE_URL}"

FROM nginx:1.31-alpine AS runtime
COPY docker/flutter-web-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/build/web /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
