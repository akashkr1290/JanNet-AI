# JanNet AI - root environment configuration (Phase 18: Docker)
#
# PRE-EXISTING GAP CLOSED THIS PHASE: this file is referenced by name
# throughout the codebase (backend/src/main/resources/application.yml's
# own header comment, flutter/lib/core/api/api_config.dart's doc comment,
# README.md's repository-layout diagram, and several PROJECT_INTEGRATION.md
# Section 6 entries dating back to Phase 4/8) but did not actually exist
# anywhere in the Phase 1-17 deliverable ZIPs - confirmed by a full
# recursive search of the Phase 17 baseline before writing this file. Every
# default value below is taken from the current, authoritative source for
# that setting (application.yml's ${VAR:default} syntax, ai-service's own
# app/config.py defaults, or ai-service/.env.example) - not reconstructed
# from the old PROJECT_INTEGRATION.md history, which cannot be verified
# against actual file content that no longer exists. See PROJECT_INTEGRATION.md
# Section 6 ("Phase 18 - root .env.example and .gitignore did not exist")
# for the full audit.
#
# Copy this file to `.env` in the repo root before running
# `docker compose -f docker/docker-compose.yml up`. Never commit a real
# `.env` (see root .gitignore, also added this phase).

# =============================================================================
# --- MySQL container (docker/docker-compose.yml's `mysql` service) ---------
# =============================================================================
# These four seed the official mysql:8 image's own first-boot init
# (MYSQL_DATABASE/MYSQL_USER/MYSQL_PASSWORD create a non-root schema+user;
# MYSQL_ROOT_PASSWORD is only ever used for root-level administration, e.g.
# database/scripts/backup.sh|restore.sh). DB_NAME/DB_USERNAME/DB_PASSWORD
# below (read by the backend) MUST match MYSQL_DATABASE/MYSQL_USER/
# MYSQL_PASSWORD exactly - docker-compose.yml maps them from these same
# values so they can never drift apart.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
DB_NAME=jannet_ai
DB_USERNAME=jannet_user
DB_PASSWORD=CHANGE_ME

# Host/port the *backend* connects to. Inside docker-compose this is always
# the MySQL service name (`mysql`) and its container-internal port (3306) -
# left overridable for the rare case of pointing a container backend at an
# external/managed MySQL instance instead of the compose-managed one.
DB_HOST=mysql
DB_PORT=3306
# Audit GAP-041 (SRS 26): a database connection attempt fails after this many
# ms, and starting a transaction is retried up to DB_TRANSIENT_RETRY_MAX times
# with exponential backoff (DB_TRANSIENT_RETRY_BASE_DELAY_MS, doubled each
# retry) when the connection is transiently unavailable.
DB_CONNECTION_TIMEOUT_MS=5000
DB_TRANSIENT_RETRY_MAX=3
DB_TRANSIENT_RETRY_BASE_DELAY_MS=200

# =============================================================================
# --- Spring Boot backend (docker/Dockerfile.backend) -----------------------
# =============================================================================
SERVER_PORT=8080
# `dev` here (not `prod`) matches application.yml's own stated philosophy
# - "sane local-dev defaults so ... works out of the box" - the same
# reasoning docker/README.md's Quick Start relies on. Set this to `prod`
# (application-prod.yml) for a real pilot deployment, alongside real
# secret values everywhere below that currently say CHANGE_ME.
SPRING_PROFILES_ACTIVE=dev
APP_NAME=jannet-ai

# SRS 15.2/27.1: JWT access tokens expire after 30 minutes (Phase 4).
# JWT_SECRET has no safe default - generate a real 256-bit+ random value
# for any environment beyond a throwaway local sandbox.
JWT_SECRET=CHANGE_ME_MIN_256_BIT_SECRET_CHANGE_ME
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Phase 4 (SuperAdminBootstrap): empty by default (no-op). Set all three to
# get a first ADMIN/SUPER_ADMIN login on a fresh database. Never set
# BOOTSTRAP_SUPER_ADMIN_PASSWORD to a real production credential in any
# committed file - this is a template, not a secrets store.
BOOTSTRAP_SUPER_ADMIN_MOBILE=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_NAME=System Administrator

# Phase 6 (StorageService local-disk stub, Section 5 of
# PROJECT_INTEGRATION.md): mounted as a named Docker volume
# (`backend_storage`) in docker-compose.yml so uploaded complaint photos
# survive a container restart. Path is inside the container's filesystem,
# not the host's.
LOCAL_STORAGE_PATH=/app/storage

# SRS 15.5 (GPS Module): deliberately permissive placeholder bounding box
# (all of India) - see application.yml's own comment. Narrow this to the
# real municipal boundary for an actual pilot deployment.
GEO_MIN_LAT=6.5
GEO_MAX_LAT=37.1
GEO_MIN_LNG=68.0
GEO_MAX_LNG=97.5

# SRS 15.1 anti-spam control (configurable, no SRS-given override value).
COMPLAINT_MAX_PER_24H=10
# Days a RESOLVED complaint waits for the citizen to confirm/reopen before it
# closes automatically (pilot decision 2026-09-30: 3). Admin setting
# citizen_confirmation_days overrides it.
COMPLAINT_REOPEN_GRACE_DAYS=3
# Audit GAP-054 (SRS 17.2): complaint description profanity filter. No word
# list ships with the code (product-owner decision). Either a comma-separated
# list, or a UTF-8 file path (one entry per line, '#' comments). Empty = off.
COMPLAINT_PROFANITY_WORDS=
COMPLAINT_PROFANITY_WORDLIST_PATH=
# REJECT (400, citizen rephrases) or MASK (matched words stored as ****).
COMPLAINT_PROFANITY_ACTION=REJECT

# Audit GAP-039 (SRS 15.12): period report limits. Max range default 1 year;
# reports with fewer received complaints than REPORTS_MIN_COMPLAINTS are
# labelled INSUFFICIENT DATA (no SRS number; 1 = only empty periods).
REPORTS_MAX_RANGE_DAYS=366
REPORTS_MIN_COMPLAINTS=1

# Phase 8: AI Analysis Module integration. Inside docker-compose this is
# always the ai-service service name (`ai-service`) and its
# container-internal port (8001). AI_SERVICE_API_KEY MUST match the
# ai-service container's own AI_SERVICE_API_KEY exactly (shared secret,
# sent as the X-Internal-Api-Key header) - both env vars below are wired
# from this single value in docker-compose.yml so they can never drift.
AI_SERVICE_BASE_URL=http://ai-service:8001
AI_SERVICE_API_KEY=change-me-in-every-real-environment
AI_SERVICE_ENABLED=true
AI_SERVICE_CONNECT_TIMEOUT_MS=5000
AI_SERVICE_READ_TIMEOUT_MS=30000

# Phase 9 (SRS 15.6 duplicate-detection candidate-pool shaping).
DUPLICATE_CANDIDATE_WINDOW_DAYS=30
DUPLICATE_MAX_CANDIDATES=25

# Phase 11 (SRS 15.7: unmapped categories default to a configurable
# fallback department; V15 seeded this under the literal name below).
DEPARTMENT_ASSIGNMENT_FALLBACK_NAME=General Triage

# SRS 15.9 - documented placeholder, no SRS-given concrete number (Phase 11).
BUDGET_APPROVAL_THRESHOLD_INR=50000

# Phase 11 (SRS 14.3 per-severity SLA table).
ESCALATION_SLA_HOURS_CRITICAL=24
ESCALATION_SLA_HOURS_HIGH=72
ESCALATION_SLA_HOURS_MEDIUM=168
ESCALATION_SLA_HOURS_LOW=336
ESCALATION_SWEEP_INTERVAL_MS=900000

# Phase 15 (Notification Module, SRS 15.13). Both channels default OFF -
# an unconfigured deployment logs a stub line instead of failing every
# citizen-facing status update with a transport error. Set *_ENABLED=true
# and fill in the real gateway credentials for a live deployment.
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_FROM=no-reply@jannetai.local
# SMS is REQUIRED for citizen registration: without it the registration /
# resend / MFA OTP cannot be sent, and the API answers 503
# OTP_DELIVERY_FAILED instead of pretending success
# (docs/REGISTRATION_OTP_SMS.md). Citizens may instead choose e-mail for the
# registration / password-reset code (needs NOTIFICATION_EMAIL_ENABLED + SMTP).
# No SMS vendor is built in (audit GAP-003): the generic-http adapter is mapped
# onto your provider's documented HTTP API with the settings below - see
# docs/SMS_PROVIDER_CONFIGURATION.md. The defaults POST
# {"to":"+<E.164 number>","message":"..."} with "Authorization: Bearer <key>".
NOTIFICATION_SMS_ENABLED=false
SMS_PROVIDER=generic-http
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
# JSON | FORM
SMS_PROVIDER_REQUEST_FORMAT=JSON
# BEARER | HEADER | BASIC | QUERY | NONE
SMS_PROVIDER_AUTH_SCHEME=BEARER
SMS_PROVIDER_AUTH_HEADER=Authorization
SMS_PROVIDER_AUTH_QUERY_PARAM=apikey
SMS_PROVIDER_BASIC_USERNAME=
# E164 (+919876543210) | DIGITS (919876543210) | NATIONAL (9876543210)
SMS_PROVIDER_NUMBER_FORMAT=E164
SMS_PROVIDER_TO_FIELD=to
SMS_PROVIDER_MESSAGE_FIELD=message
# Sender ID / DLT header, and Indian DLT entity + template IDs. A blank *_FIELD
# means that value is not sent.
SMS_PROVIDER_SENDER_FIELD=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID_FIELD=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID_FIELD=
SMS_OTP_DLT_TEMPLATE_ID=
SMS_NOTIFICATION_DLT_TEMPLATE_ID=
# Optional regex the provider's 2xx response body must match (for providers
# that answer HTTP 200 with an error in the body).
SMS_PROVIDER_SUCCESS_PATTERN=
# Country code added to stored 10-digit numbers when sending (+91 = India).
SMS_DEFAULT_COUNTRY_CODE=+91
SMS_CONNECT_TIMEOUT_MS=5000
SMS_READ_TIMEOUT_MS=10000
# Optional OTP message text; placeholders {otp} {purpose} {minutes}. Leave
# empty for the built-in text. In India it must match your DLT-registered
# template exactly, or operators will not deliver it.
OTP_SMS_TEMPLATE=
# DEVELOPMENT ONLY: with SMS not configured, write the OTP to the backend log
# ([OTP-DEV]) so local registration can be completed. Ignored under the prod
# profile. Never set this to true in production.
OTP_DEV_LOG_CODE=false
NOTIFICATION_MAX_DELIVERY_ATTEMPTS=3
NOTIFICATION_RETRY_BACKOFF_BASE_MS=200

# SMTP transport backing NOTIFICATION_EMAIL_ENABLED above.
# Audit GAP-012: keep false unless SMTP is configured - otherwise the mail
# health indicator makes /actuator/health report DOWN.
MANAGEMENT_HEALTH_MAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Audit GAP-010: asynchronous AI processing (POST /complaints no longer waits
# for ai-service). Failed attempts are retried with exponential backoff; after
# AI_PROCESSING_MAX_ATTEMPTS (or a non-retryable error such as an unusable
# photo) the Verification Team is alerted to verify the complaint manually.
AI_PROCESSING_ASYNC_ENABLED=true
AI_PROCESSING_MAX_ATTEMPTS=3
AI_PROCESSING_RETRY_BASE_DELAY_SECONDS=30
AI_PROCESSING_SWEEP_INTERVAL_MS=60000

# Phase 16 (Analytics Module, SRS 15.14): nightly aggregation refresh,
# default 2 AM daily - documented placeholder, no SRS-given exact time.
ANALYTICS_AGGREGATION_CRON=0 0 2 * * *

# =============================================================================
# --- Python AI service (docker/Dockerfile.ai-service) -----------------------
# =============================================================================
# Full field-level documentation for every one of these lives in
# ai-service/.env.example (Phase 7) - not duplicated here to avoid the two
# files drifting out of sync; only the ones docker-compose.yml actually
# injects as container environment variables are listed, with the same
# names and defaults as ai-service/.env.example.
# `local` here (not `production`) matches SPRING_PROFILES_ACTIVE's own
# dev-default reasoning above: app/main.py's own startup check refuses to
# boot with the placeholder AI_SERVICE_API_KEY below when this is
# anything other than `local` (see that file's on_startup handler) - so
# `docker compose up` works out of the box with zero secrets changed.
# Set this to `production` alongside a real AI_SERVICE_API_KEY for an
# actual pilot deployment.
AI_SERVICE_ENV=local
# Audit GAP-041 (SRS 27): ai-service log format - json or text. Empty = json
# unless AI_SERVICE_ENV=local. The backend logs JSON under the prod Spring
# profile (logback-spring.xml) and text otherwise; both include the request id.
LOG_FORMAT=
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001

AUTO_APPROVE_CONFIDENCE_THRESHOLD=50.0
MIN_DETECTION_THRESHOLD=50.0
GEMINI_FALLBACK_CONFIDENCE_CAP=70.0

# Audit GAP-032: SRS 17.2 minimum 480p (short side).
MIN_IMAGE_WIDTH_PX=480
MIN_IMAGE_HEIGHT_PX=480
# Audit GAP-009: longer side is reduced to this before denoising (speed).
PREPROCESS_MAX_SIDE_PX=1600
BLUR_VARIANCE_THRESHOLD=80.0
MAX_IMAGE_BYTES=10485760

# Audit GAP-016/GAP-060: the real trained model (models/registry.json "active")
# is tracked with Git LFS and baked into the ai-service image; the Docker build
# fails if it is missing or its SHA-256 does not match the registry
# (ai-service/scripts/verify_model.py). Values below match registry.json.
YOLO_MODEL_PATH=models/yolov11-civic-v1.1.pt
# Remaining-gaps item 13: resolve the model from models/registry.json "active" instead
# (promote/rollback with ai-service/scripts/model_registry.py, then restart)
USE_MODEL_REGISTRY=false
YOLO_MODEL_VERSION=yolov11-civic-v1.1
# true = refuse to start when the model cannot be loaded (set in production).
REQUIRE_MODEL=false

# Leave unset to run in fallback-only mode (no external Gemini calls
# attempted) - this workspace's own default, unchanged here.
GEMINI_API_KEY=
# Audit GAP-007: gemini-1.5-flash was shut down; use a current model from
# https://ai.google.dev/gemini-api/docs/models (SDK: google-genai).
GEMINI_MODEL_NAME=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=8
# Remaining-gaps item 2: bounded retry for transient Gemini errors (0 = off)
GEMINI_MAX_RETRIES=1

OCR_ENABLED=true
TESSERACT_CMD_PATH=

IMAGE_FETCH_TIMEOUT_SECONDS=10

PRIORITY_CORROBORATION_SEVERITY_THRESHOLD=3
PRIORITY_SAFETY_HAZARD_CATEGORIES=OPEN_MANHOLE

BUDGET_GUARDRAIL_MIN_INR=500.0
BUDGET_GUARDRAIL_MAX_INR=500000.0

# =============================================================================
# --- Flutter (build-time --dart-define, not read by any container) --------
# =============================================================================
# Flutter has no .env reader wired up (flutter_dotenv vs. --dart-define is
# still an undecided build-tooling choice - see
# flutter/lib/core/api/api_config.dart's own doc comment). This value is
# documented here purely so one file lists every base URL this project
# uses, matching api_config.dart's existing convention; no docker-compose
# service reads it. Point this at whichever host can actually reach the
# `backend` container port (see docker/README.md - localhost for a
# desktop/web build, 10.0.2.2 for the Android emulator, your machine's LAN
# IP for a physical device):
#   flutter run --dart-define=API_BASE_URL=http://localhost:8080/api/v1
API_BASE_URL=http://localhost:8080/api/v1

# -----------------------------------------------------------------------------
# Flutter Docker setup (docs/FLUTTER_DOCKER_SETUP.md)
# -----------------------------------------------------------------------------
# Flutter SDK used by both Flutter images (matches flutter/.metadata).
FLUTTER_VERSION=3.47.1
# Host port for the always-running Flutter Web frontend (nginx listens on 80 inside).
FLUTTER_WEB_PORT=3000
# API URL compiled into the WEB build. The app runs in the browser, so use the
# backend's host-reachable address (SERVER_PORT above), never http://backend:8080.
# Rebuild the frontend image after changing it.
FLUTTER_WEB_API_BASE_URL=http://localhost:8080/api/v1
# Browser origins the backend accepts (CORS), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Android build container: run as your host user so artifacts are not root-owned
# (Linux: `id -u` / `id -g`).
HOST_UID=1000
HOST_GID=1000
# Allow http:// API URLs in RELEASE Android builds (local testing only).
JANNET_ALLOW_CLEARTEXT=false
