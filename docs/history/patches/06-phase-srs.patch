+  test('parses a period report including the insufficient-data label', () {
+    final r = PeriodReportSummary.fromJson({
+      'reportType': 'WEEKLY',
+      'periodStart': '2026-09-15',
+      'periodEnd': '2026-09-21',
+      'departmentName': 'Roads',
