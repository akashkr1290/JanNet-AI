+                          ),
+                        ],
+                      ),
+                    ],
+                  ),
+                ),
+              ],
+            ),
+          );
+        },
+      ),
+    );
+  }
+
+  Widget _header(UserProfile p) {
+    final initials = p.fullName
+        .trim()
+        .split(RegExp(r'\s+'))
+        .where((x) => x.isNotEmpty)
