+                                width: 18,
+                                height: 18,
+                                child: CircularProgressIndicator(strokeWidth: 2.2, color: JanColors.white),
+                              )
+                            : const Icon(Icons.save_outlined),
+                        label: Text(_saving ? 'Saving...' : 'Save Changes'),
+                      ),
+                    ],
+                  ),
+                ),
+                const JanSectionHeader(title: 'Sign-in Details'),
+                JanCard(
+                  child: Column(
