--- a/.env.example
+++ b/.env.example
@@ -127,13 +127,39 @@ NOTIFICATION_EMAIL_FROM=no-reply@jannetai.local
 # SMS is REQUIRED for citizen registration: without it the registration /
 # resend / MFA OTP cannot be sent, and the API answers 503
 # OTP_DELIVERY_FAILED instead of pretending success
-# (docs/REGISTRATION_OTP_SMS.md). No SMS vendor is built in: SMS_PROVIDER_URL
-# must accept POST {"to":"+<E.164 number>","message":"..."} with the header
-# "Authorization: Bearer <SMS_PROVIDER_API_KEY>" (a provider API with that
-# contract, or a thin relay in front of your provider).
+# (docs/REGISTRATION_OTP_SMS.md). Citizens may instead choose e-mail for the
+# registration / password-reset code (needs NOTIFICATION_EMAIL_ENABLED + SMTP).
+# No SMS vendor is built in (audit GAP-003): the generic-http adapter is mapped
+# onto your provider's documented HTTP API with the settings below - see
+# docs/SMS_PROVIDER_CONFIGURATION.md. The defaults POST
+# {"to":"+<E.164 number>","message":"..."} with "Authorization: Bearer <key>".
 NOTIFICATION_SMS_ENABLED=false
+SMS_PROVIDER=generic-http
 SMS_PROVIDER_URL=
 SMS_PROVIDER_API_KEY=
+# JSON | FORM
+SMS_PROVIDER_REQUEST_FORMAT=JSON
+# BEARER | HEADER | BASIC | QUERY | NONE
+SMS_PROVIDER_AUTH_SCHEME=BEARER
+SMS_PROVIDER_AUTH_HEADER=Authorization
+SMS_PROVIDER_AUTH_QUERY_PARAM=apikey
+SMS_PROVIDER_BASIC_USERNAME=
+# E164 (+919876543210) | DIGITS (919876543210) | NATIONAL (9876543210)
+SMS_PROVIDER_NUMBER_FORMAT=E164
+SMS_PROVIDER_TO_FIELD=to
+SMS_PROVIDER_MESSAGE_FIELD=message
+# Sender ID / DLT header, and Indian DLT entity + template IDs. A blank *_FIELD
+# means that value is not sent.
+SMS_PROVIDER_SENDER_FIELD=
+SMS_SENDER_ID=
+SMS_DLT_ENTITY_ID_FIELD=
+SMS_DLT_ENTITY_ID=
+SMS_DLT_TEMPLATE_ID_FIELD=
+SMS_OTP_DLT_TEMPLATE_ID=
+SMS_NOTIFICATION_DLT_TEMPLATE_ID=
+# Optional regex the provider's 2xx response body must match (for providers
+# that answer HTTP 200 with an error in the body).
+SMS_PROVIDER_SUCCESS_PATTERN=
 # Country code added to stored 10-digit numbers when sending (+91 = India).
 SMS_DEFAULT_COUNTRY_CODE=+91
 SMS_CONNECT_TIMEOUT_MS=5000
